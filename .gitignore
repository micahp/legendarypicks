# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
*/__pycache__/*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

testnet-account.private.json

package-lock.json
yarn.lock

# Flow private keys
/keys/*.pkey

# generated sports backend DB / cache
backend/data/picks.db
backend/__pycache__/
backend/venv/

.next/

# DB backups — never commit
*.bak
*.bak-*
backend/data/*.bak*
backend/data/picks.dev.db
esports_results.json

# catch __pycache__ at any depth
__pycache__/
*.pyc

# esports state monitor — runtime output, not source
backend/data/esports_state_snapshot.json
logs/

# isolated build output
.next-build
