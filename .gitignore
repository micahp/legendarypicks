# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
*/__pycache__/*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

testnet-account.private.json

package-lock.json
yarn.lock

# Flow private keys
/keys/*.pkey

# generated sports backend DB / cache
backend/data/picks.db
backend/__pycache__/
backend/venv/

.next/

# DB backups — never commit.
# Match the database NAME, not a suffix. Repair scripts write copies as
# `picks.db.pre-<label>-<stamp>` with no `.bak` at all, so the suffix patterns
# below missed 0.93GB of them and left `git status` unreadable (2026-08-11).
# Same root cause as the .dockerignore miss that baked 7.45GB into an image.
backend/data/picks.db*
backend/data/picks.dev.db*
*.bak
*.bak-*
backend/data/*.bak*
esports_results.json

# catch __pycache__ at any depth
__pycache__/
*.pyc

# esports state monitor — runtime output, not source
backend/data/esports_state_snapshot.json
backend/data/plays_board.json
logs/

# isolated build output
.next-build

# v0.6.13 re-cut: disposable clone + large pinned artifact (sha256 recorded in PINNED-ARTIFACTS)
backend/data/rehearsal-v0.6.13.db
backend/data/espn_2026_snapshot_page1.json

# reconcile_totals run artifacts: an append-only run log and a cache of immutable
# ESPN event documents. Both are rebuilt on demand and neither is a source of truth.
backend/data/reconcile.log
backend/data/reconcile-event-cache.json

# Fetched ESPN payloads — a cache, never source.
backend/data/espn-cache/

# News engine POC fetch cache
sketches/.news_cache/
backend/data/news-cache/
backend/data/news-deletions.log

# Dev-server and agent logs — per-port scratch (next3096.log, cf3096.log,
# be8096.log, backfill resume logs). These made up a third of the untracked
# entries and left `git status` unreadable (2026-08-11).
*.log

# A 0-byte `picks.dev.db` appeared at the REPO ROOT (2026-08-10) from a process
# started with the wrong cwd. It is the worst kind of stray: anything opening the
# dev DB by relative path finds it, gets an EMPTY database, and answers 200 with
# no data. Ignored here so it can never be committed. Never create one.
/picks.dev.db

# Agent state, not source. `.context/retros/` is deliberately TRACKED history
# (see the committed retros) — do not ignore it.
.hermes/

# Bovada per-league backoff state. Runtime operational scheduling, NOT app data —
# the scraper rewrites it every run, so tracking it dirtied the working tree on a
# 30-minute timer and blocked `release.sh`'s clean-tree preflight indefinitely
# (2026-08-17: one changed timestamp was the sole thing standing between dev and
# a v0.8.0 dry-run). `_load_backoff()` returns {} when the file is absent, so a
# fresh checkout or image simply fetches every league — it fails open by design.
backend/data/bovada-league-backoff.json

# ESPN response disk cache. 96MB of hashed request/response JSON, rewritten by any
# script that calls a publisher — tracking it dirtied the tree on every run and blocked
# `release.sh`'s clean-tree preflight (2026-08-17).
#
# It was never meant to be tracked: it rode into 8b296db, a one-line build fix, as 218
# of that commit's 292 files. Note line 88 already ignored `backend/data/espn-cache/` —
# the intent was there, the path was wrong. The cache lives at `backend/.espn-cache`,
# which that pattern never matched. Same miss as `backend/backups/` dodging
# `backend/data/picks.db*` the same day: an ignore rule only protects the path it names.
backend/.espn-cache/

# Compose reads ./.env for ${VAR} interpolation, which is how the backend's
# pass-through keys (PANDASCORE/GRID/YOUTUBE/DEEPSEEK/KICK) reach the container.
# It is a SYMLINK to /root/.hermes/.env so there is no second copy of a secret
# on disk — but it must never be committed, symlink or not. `.env*.local` above
# did not cover the plain name.
.env

# Runtime spend log (paced_http.record_spend). A process rewrites this
# continuously, and a tracked file a runtime process rewrites is what blocked
# the v0.8.0 cut for a week. See docs/DESIGN-request-budget.md.
backend/data/http-spend.jsonl
