# Legendary Picks — data pipeline schedule
# All jobs run via the backend venv. Logs go to /opt/legendarypicks/logs/
# (adjust paths to your install root — these assume /opt/legendarypicks)
#
# Install: cp legendarypicks-pipeline.cron /etc/cron.d/legendarypicks-pipeline
#          chmod 644 /etc/cron.d/legendarypicks-pipeline
# Verify:  crontab -l (cron will pick up /etc/cron.d/ automatically)

PIPELINE=/opt/legendarypicks/backend/venv/bin/python
SCRIPTS=/opt/legendarypicks/scripts
BACKEND=/opt/legendarypicks/backend

# Ingest fresh props from Bovada — 4x/day during active-game windows
# MLB day games + evening
0 13,17,20,23 * * * root cd /opt/legendarypicks/backend && $PIPELINE bovada_scraper.py mlb --ingest >> /opt/legendarypicks/logs/bovada_cron.log 2>&1

# Link games + settle finaled games — every 30 min in evening/overnight
# (games go final throughout the evening)
*/30 19-23,0-3 * * * root $PIPELINE $SCRIPTS/run_pipeline.py >> /opt/legendarypicks/logs/pipeline_cron.log 2>&1

# Full pipeline with stat refresh — 2x/day (morning + after games finish)
# NHL roster + MLB Statcast full-season pull
0 8,4 * * * root $PIPELINE $SCRIPTS/run_pipeline.py --full >> /opt/legendarypicks/logs/pipeline_full_cron.log 2>&1

# Coverage report — daily at 9am
0 9 * * * root $PIPELINE $SCRIPTS/coverage_report.py >> /opt/legendarypicks/logs/coverage_cron.log 2>&1
