# Legendary Picks — DEV data pipeline schedule
# Keeps picks.dev.db populated with live props so dev game summaries / projections have
# player form data, mirroring the prod cron (legendarypicks-pipeline). Without this you
# have to hand-run the ingest into dev every day.
#
# Targeting: link/settle/coverage write picks.dev.db (LP_DB_PATH). Props publication is
# explicitly skipped because run_props_ingest.py owns it. This does NOT run --full — dev's player_game_logs /
# player_stats are managed separately and are AHEAD of prod, so the stat-refresh must not run here.
#
# Install: cp scripts/legendarypicks-dev-pipeline.cron /etc/cron.d/legendarypicks-dev-pipeline
#          chmod 644 /etc/cron.d/legendarypicks-dev-pipeline
# (cron picks up /etc/cron.d/ automatically; no `crontab` import needed.)

PIPELINE=/root/legendarypicks/backend/venv/bin/python
SCRIPTS=/root/legendarypicks/scripts
LOGDIR=/root/legendarypicks/logs
LP_API_BASE=http://127.0.0.1:8096
LP_DB_PATH=/root/legendarypicks/backend/data/picks.dev.db

# Link games + settle finaled games in DEV. The props runner is the only props publisher.
13 12,16,20,23 * * * root $PIPELINE $SCRIPTS/run_pipeline.py --skip-props >> $LOGDIR/dev_pipeline_cron.log 2>&1
