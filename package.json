{
  "name": "fcl-next-scaffold",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_PUBLIC_FLOW_NETWORK=local next dev",
    "dev-wait": "yarn dev & wait-on tcp:8888 tcp:8701 tcp:3000",
    "dev:local": "concurrently \"yarn flow:emulator\" \"yarn flow:dev-wallet\" \"yarn dev:local:flow\"",
    "dev:local:flow": "yarn dev-wait && yarn flow:dev",
    "dev:local:deploy": "flow project deploy --network=emulator --update && cross-env NEXT_PUBLIC_FLOW_NETWORK=local yarn dev",
    "dev:testnet": "cross-env NEXT_PUBLIC_FLOW_NETWORK=testnet next dev",
    "dev:testnet:deploy": "flow project deploy --network=testnet --update && cross-env NEXT_PUBLIC_FLOW_NETWORK=testnet yarn dev",
    "dev:testnet:update": "flow project deploy --network=testnet --update --show-diff",
    "dev:mainnet": "cross-env NEXT_PUBLIC_FLOW_NETWORK=mainnet next dev",
    "flow:dev": "flow dev",
    "flow:emulator": "flow emulator",
    "flow:dev-wallet": "flow dev-wallet",
    "dev:backend": "cd backend && source ~/.venv/bin/activate && python3 -m uvicorn nba_service:app --reload",
    "dev:all": "concurrently --kill-others-on-fail \"yarn flow:emulator\" \"yarn flow:dev-wallet\" \"yarn dev:local:flow\" \"yarn dev:backend\"",
    "build:css": "tailwindcss build styles/globals.css -o styles/output.css"
  },
  "dependencies": {
    "@onflow/fcl": "1.4.1",
    "@onflow/typedefs": "1.1.0",
    "elliptic": "^6.5.4",
    "next": "13.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sha3": "^2.1.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/elliptic": "^6.4.14",
    "@types/react": "19.0.8",
    "@types/node": "^18.0.0",
    "concurrently": "^8.0.1",
    "cross-env": "^7.0.3",
    "eslint": "8.26.0",
    "eslint-config-next": "13.0.0",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.3.1",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16",
    "postcss-loader": "^7.3.3",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "typescript": "5.7.3",
    "wait-on": "^7.0.1"
  }
}
