{
  "name": "legendarypicks",
  "version": "0.2.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:backend": "cd backend && venv/bin/python -m uvicorn sports_service:app --reload",
    "dev:sports-backend": "cd backend && venv/bin/python -m uvicorn sports_service:app --reload",
    "dev:phase1": "concurrently --kill-others-on-fail \"yarn dev:sports-backend\" \"next dev\"",
    "build:css": "tailwindcss build styles/globals.css -o styles/output.css"
  },
  "dependencies": {
    "@swc/core": "^1.7.0",
    "axios": "^1.18.0",
    "next": "13.0.0",
    "playwright": "^1.60.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/node": "^18.0.0",
    "@types/react": "19.0.8",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.0.1",
    "css-loader": "^6.8.1",
    "eslint": "8.26.0",
    "eslint-config-next": "13.0.0",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.3.1",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "puppeteer-core": "^25.1.0",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.7.3"
  }
}
