[Unit]
Description=Refresh NFL fantasy ADP (ESPN)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/legendarypicks/backend
Environment=LP_DB_PATH=/root/legendarypicks/backend/data/picks.dev.db
ExecStart=/root/legendarypicks/backend/venv/bin/python /root/legendarypicks/backend/ingest_nfl_adp.py
TimeoutStartSec=300
Nice=10
