[Unit]
Description=Probe the RotoWire picks relay for a PrizePicks MLS board
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/legendarypicks/backend
Environment=LP_DB_PATH=/root/legendarypicks/backend/data/picks.dev.db
ExecStart=/root/legendarypicks/backend/venv/bin/python /root/legendarypicks/backend/monitor_rotowire_soccer.py
TimeoutStartSec=180
Nice=15
