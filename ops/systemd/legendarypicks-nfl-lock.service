[Unit]
Description=Lock every live NFL model 90 minutes before kickoff (v1, v2 EPA, v1 + Elo)
After=network-online.target
OnFailure=legendarypicks-ops-alert@%N.service

[Service]
Type=oneshot
WorkingDirectory=/root/legendarypicks/backend
Nice=10
Environment=LP_DB_PATH=/root/legendarypicks/backend/data/picks.dev.db
ExecStart=/root/legendarypicks/backend/venv/bin/python lock_nfl_models.py --apply
TimeoutStartSec=1800
