[Unit]
Description=Refresh and link World Cup player props
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/legendarypicks/backend
Environment=LP_DB_PATH=/root/legendarypicks/backend/data/picks.dev.db
ExecStart=/root/legendarypicks/backend/venv/bin/python /root/legendarypicks/backend/bovada_scraper.py wc --ingest
TimeoutStartSec=120
Nice=10
