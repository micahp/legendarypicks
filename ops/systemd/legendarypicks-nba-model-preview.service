[Unit]
Description=Refresh pregame NBA research model previews on dev

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/legendarypicks/backend
Environment=LP_DB_PATH=/root/legendarypicks/backend/data/picks.dev.db
Environment=NBA_MODEL_DB_PATH=/root/legendarypicks/backend/data/nba-model.dev.sqlite3
ExecStart=/root/legendarypicks/backend/venv/bin/python /root/legendarypicks/backend/refresh_nba_model_previews.py
Nice=10
