[Unit]
Description=Check ingest registry freshness twice an hour

[Timer]
# Absolute, for the reason in legendarypicks-props.timer. Offset from the ingest run at :22
# so a check never races the job it is checking.
OnCalendar=*-*-* *:47:00
Persistent=true
Unit=legendarypicks-ingest-freshness.service

[Install]
WantedBy=timers.target
