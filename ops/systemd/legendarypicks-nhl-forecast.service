[Unit]
Description=Generate NHL forecasts for upcoming games
After=network-online.target
Wants=network-online.target
OnFailure=legendarypicks-ops-alert@%N.service

[Service]
Type=oneshot
WorkingDirectory=/root/legendarypicks/backend
ExecStart=/root/legendarypicks/backend/venv/bin/python /root/legendarypicks/backend/generate_nhl_forecasts.py --apply
TimeoutStartSec=300
