[Unit]
Description=Refresh Underdog UFC props every 30 minutes (DEV)

[Timer]
# Offset from the existing Bovada dev timer so the two SQLite writers do not
# normally contend; the service lock also prevents self-overlap.
OnCalendar=*-*-* *:07:00
OnCalendar=*-*-* *:37:00
Persistent=true
Unit=legendarypicks-underdog-ufc-props.service

[Install]
WantedBy=timers.target
