[Unit]
Description=Refresh the scoreboard slates the board serves (live)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/legendarypicks/backend
Environment=LP_DB_PATH=/root/legendarypicks/backend/data/picks.dev.db
ExecStart=/root/legendarypicks/backend/venv/bin/python /root/legendarypicks/backend/ingest_scoreboards.py --live --quiet
TimeoutStartSec=120
Nice=10
