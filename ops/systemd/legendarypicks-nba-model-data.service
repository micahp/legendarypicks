[Unit]
Description=Refresh verified NBA team boxscores for the dev game model
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/legendarypicks/backend
Environment=LP_DB_PATH=/root/legendarypicks/backend/data/picks.dev.db
Environment=NBA_MODEL_DB_PATH=/root/legendarypicks/backend/data/nba-model.dev.sqlite3
ExecStart=/root/legendarypicks/backend/venv/bin/python /root/legendarypicks/backend/refresh_nba_model_data.py
Nice=10
