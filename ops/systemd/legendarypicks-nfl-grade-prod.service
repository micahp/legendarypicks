[Unit]
Description=Grade finished locked NFL projections in production
After=network-online.target
Wants=network-online.target
OnFailure=legendarypicks-ops-alert@%N.service

[Service]
Type=oneshot
WorkingDirectory=/root/legendarypicks/backend
Environment=LP_DB_PATH=/root/legendarypicks/backend/data/picks.db
Nice=15
ExecStart=/root/legendarypicks/backend/venv/bin/python /root/legendarypicks/backend/grade_nfl_locks.py
TimeoutStartSec=120
