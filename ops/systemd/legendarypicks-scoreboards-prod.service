[Unit]
Description=Refresh the scoreboard slates the board serves — PROD
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/legendarypicks/backend
Environment=LP_DB_PATH=/root/legendarypicks/backend/data/picks.db
ExecStart=/root/legendarypicks/backend/venv/bin/python /root/legendarypicks/backend/ingest_scoreboards.py
TimeoutStartSec=600
Nice=10
