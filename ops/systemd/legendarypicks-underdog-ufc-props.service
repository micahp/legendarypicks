[Unit]
Description=Refresh Underdog UFC props into LegendaryPicks DEV
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/legendarypicks/backend
Environment=LP_DB_PATH=/root/legendarypicks/backend/data/picks.dev.db
# A non-blocking lock stops a delayed timer run from overlapping the next one.
# Exit 75 means the lock was already held and is an intentional no-op.
ExecStart=/bin/sh -c '/usr/bin/flock -n -E 75 /run/lock/legendarypicks-underdog-ufc-props.lock /root/legendarypicks/backend/venv/bin/python /root/legendarypicks/backend/ingest_underdog_props.py ufc; lock_status=$?; [ "$lock_status" -eq 75 ] && exit 0; exit "$lock_status"'
TimeoutStartSec=120
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
