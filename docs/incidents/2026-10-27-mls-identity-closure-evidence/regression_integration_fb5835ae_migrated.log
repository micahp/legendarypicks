    @router.get("/api/props/history")
    def prop_history(player_id: int = Query(...),
                     market: str = Query(...),
                     line: float = Query(...),
                     side: str = Query("over"),
                     league: str = Query(...),
                     season: Optional[int] = None,
                     without: Optional[str] = Query(None),
                     with_: Optional[str] = Query(None, alias="with")):
        """Per-game stat history for a prop's player+market, with the line.
    
        ``without`` / ``with`` (comma-separated teammate player ids, NFL only) keep only the games where
        every ``without`` teammate had played = 0 and every ``with`` teammate played = 1, read through
        player_splits (one definition of "did X play"). Games with unknown availability are excluded and
        counted, never folded into either side.
        """
        without_ids = _parse_teammate_ids(without, "without")
        with_ids = _parse_teammate_ids(with_, "with")
        filtering = bool(without_ids or with_ids)
        if filtering and league != "nfl":
            return {"error": "without/with filters are NFL only", "games": []}
        if (
            league in _SOCCER_CHART_LEAGUES
            and _base_market(market) in _SOCCER_NON_FOTMOB_HISTORY
        ):
            return {
                "error": "market not published in approved FotMob history: {}".format(market),
                "games": [],
            }
        canonical_market = _base_market(market)
        is_nba = league == "nba"
        target_season = season
        if is_nba and target_season is None:
            today = dt.date.today()
            # NBA seasons use their ending year throughout the data pipeline:
            # October 2026 through June 2027 is season 2027.
            target_season = today.year + 1 if today.month >= 7 else today.year
        stat_key = _MARKET_STAT_KEY.get(league, {}).get(canonical_market)
        summary_market = league == "nhl" and canonical_market in _NHL_SUMMARY_MARKETS
        if not stat_key and not summary_market:
            return {"error": f"market not chartable from logs: {market}", "games": []}
    
        # A cross-border tournament's athletes keep their domestic logs, and the chart
        # is about the PLAYER, not the competition the prop happens to sit in. Reading
        # `league='lcup'` alone gave a Liga MX player his three group games and an MLS
        # player three games instead of a season. The union is the same one the
