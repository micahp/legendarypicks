                ufc_value = f"json_extract(stats, '$.{stat_key}')"
                rows = con.execute(
                    f"""SELECT game_date, opponent, NULL AS home_away,
                                {ufc_value} AS val
                           FROM player_game_logs_ufcstats
                          WHERE player_id=? AND league='ufc'
                            AND {ufc_value} IS NOT NULL
